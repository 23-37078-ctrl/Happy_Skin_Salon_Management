# Copy this to .env.production on the VPS only. Replace both placeholders with
# independent values generated with: openssl rand -hex 32
POSTGRES_DB=happy_skin
POSTGRES_USER=salonapp
POSTGRES_PASSWORD=replace_with_random_hex_value
SECRET_KEY=replace_with_a_different_random_hex_value
ENVIRONMENT=production
CORS_ORIGINS=https://5.104.86.204
PAYPAL_CLIENT_ID=replace_with_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_sandbox_secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=replace_with_sandbox_webhook_id
VITE_PAYPAL_CLIENT_ID=replace_with_paypal_sandbox_client_id
VITE_GOOGLE_CLIENT_ID=replace_with_google_oauth_web_client_id
GCASH_MERCHANT_NAME=HAPPY SKIN
GCASH_QR_IMAGE_PATH=/run/secrets/gcash-merchant-qr.jpg
GCASH_QR_HOST_PATH=/opt/happy-skin/private-config/gcash-merchant-qr.jpg
GCASH_PROOF_STORAGE_PATH=/app/backend/private_uploads/gcash
GCASH_PROOF_MAX_BYTES=5242880

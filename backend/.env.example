# PostgreSQL / Supabase
# Copy this file to .env and replace every placeholder. Do not commit .env.
DATABASE_URL=postgresql+psycopg2://<database-user>:<database-password>@<database-host>:5432/<database-name>
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# Authentication
SECRET_KEY=<generate-a-long-random-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email and SMS
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@happyskinsalon.com
IPROG_API_TOKEN=

# OTP and OAuth
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
GOOGLE_CLIENT_ID=
ENVIRONMENT=development

# Backend reads this project-root file. Use Sandbox values for local testing.
PAYPAL_CLIENT_ID=replace_with_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_sandbox_secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=replace_with_sandbox_webhook_id

# Vite exposes only VITE_ variables to browser code; client ID is public.
VITE_PAYPAL_CLIENT_ID=replace_with_paypal_sandbox_client_id
